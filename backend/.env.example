# Keep this file on the Mac. Never put the API key in firmware or chat.
OPENAI_API_KEY=
DEVICE_TOKEN=
HOST=0.0.0.0
PORT=8765
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin
# Master playback gain (0..1); begin quiet and increase as needed.
OUTPUT_GAIN=0.06
# Correct microphone-level echo audio before applying the master gain.
ECHO_NORMALIZE=1
# "echo" returns the captured audio locally without OpenAI or API charges.
BACKEND_MODE=echo
